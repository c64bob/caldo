package view

import "caldo/internal/db"

templ ConflictListPage(conflicts []db.ConflictListRow) {
	<section class="caldo-page">
		<h2 class="caldo-page-title">Konflikte</h2>
		if len(conflicts) == 0 {
			@EmptyState("Keine ungelösten Konflikte", "Lokale und entfernte Versionen sind aktuell nicht in Konflikt.")
		}
		if len(conflicts) > 0 {
			<ul class="caldo-list" data-conflict-list>
				for _, conflict := range conflicts {
					<li class="caldo-list-row">
						<a class="caldo-list-link" href={ templ.URL("/conflicts/" + conflict.ID) }>{ conflict.TaskTitle }</a>
						<p class="caldo-meta mt-1">Typ: { conflict.ConflictType } · Projekt: { conflict.ProjectName }</p>
					</li>
				}
			</ul>
		}
	</section>
}

templ ConflictDetailPage(conflict db.ConflictDetail) {
	<section class="caldo-page">
		<h2 class="caldo-page-title">Konfliktdetail</h2>
		<p class="caldo-muted">Konflikttyp: { conflict.ConflictType } · Projekt: { conflict.ProjectName }</p>
		if conflict.BaseVTODO.Valid {
			<div>
				<h3 class="font-medium">Ausgangsversion (Base)</h3>
				<pre class="caldo-card mt-1 max-w-full overflow-x-auto text-xs">{ conflict.BaseVTODO.String }</pre>
			</div>
		}
		if conflict.LocalVTODO.Valid {
			<div>
				<h3 class="font-medium">Lokale Version</h3>
				<pre class="caldo-card mt-1 max-w-full overflow-x-auto text-xs">{ conflict.LocalVTODO.String }</pre>
			</div>
		}
		if conflict.RemoteVTODO.Valid {
			<div>
				<h3 class="font-medium">Remote-Version</h3>
				<pre class="caldo-card mt-1 max-w-full overflow-x-auto text-xs">{ conflict.RemoteVTODO.String }</pre>
			</div>
		}
	</section>
}
