package view

import "caldo/internal/db"

templ ConflictListPage(conflicts []db.ConflictListRow) {
	<section class="caldo-page">
		<div class="caldo-conflict-header">
			<div>
				<h2 class="caldo-page-title">Konflikte</h2>
				<p class="caldo-muted">Offene Konflikte, priorisiert nach notwendiger Entscheidung.</p>
			</div>
			if len(conflicts) > 0 {
				<div class="caldo-conflict-worklist-summary" data-conflict-list-summary>
					<p class="caldo-meta">Arbeitsliste</p>
					<p>{ conflictListCountLabel(len(conflicts)) }</p>
				</div>
			}
		</div>
		if len(conflicts) == 0 {
			@EmptyState("Keine ungelösten Konflikte", "Lokale und entfernte Versionen sind aktuell nicht in Konflikt.")
		}
		if len(conflicts) > 0 {
			<ul class="caldo-list caldo-conflict-list" data-conflict-list>
				for _, conflict := range conflicts {
					<li class="caldo-list-row caldo-conflict-list-row" data-conflict-list-row data-conflict-type={ conflict.ConflictType }>
						<div class="caldo-conflict-list-main">
							<div class="caldo-conflict-list-topline">
								<span class={ conflictTypeBadgeClass(conflict.ConflictType) }>{ conflictTypeLabel(conflict.ConflictType) }</span>
								<span class="caldo-meta">{ conflictCreatedAtLabel(conflict.CreatedAt) }</span>
							</div>
							<a class="caldo-list-link caldo-conflict-list-title" href={ templ.URL("/conflicts/" + conflict.ID) }>{ conflictTaskTitle(conflict.TaskTitle) }</a>
							<p class="caldo-meta mt-1">Projekt: { conflictProjectLabel(conflict.ProjectName) }</p>
							<p class="caldo-conflict-list-action" data-conflict-next-action>{ conflictNextActionLabel(conflict.ConflictType) }</p>
						</div>
						<a class="caldo-button caldo-button-secondary" href={ templ.URL("/conflicts/" + conflict.ID) }>Konflikt lösen</a>
					</li>
				}
			</ul>
		}
	</section>
}

templ ConflictDetailPage(conflict db.ConflictDetail, projectOptions []TaskProjectOption) {
	<section class="caldo-page">
		<div class="caldo-conflict-header">
			<div>
				<h2 class="caldo-page-title">Konfliktdetail</h2>
				<p class="caldo-muted">Vergleiche die gespeicherten Versionen, bevor du eine Auflösung wählst.</p>
			</div>
			<a class="caldo-button caldo-button-secondary" href="/conflicts">Zur Konfliktliste</a>
		</div>
		<div class="caldo-conflict-summary" data-conflict-summary>
			<div>
				<p class="caldo-meta">Konflikttyp</p>
				<p class="caldo-conflict-summary-value">{ conflictTypeLabel(conflict.ConflictType) }</p>
			</div>
			<div>
				<p class="caldo-meta">Projekt</p>
				<p class="caldo-conflict-summary-value">{ conflictProjectLabel(conflict.ProjectName) }</p>
			</div>
			<div>
				<p class="caldo-meta">Erkannt</p>
				<p class="caldo-conflict-summary-value">{ conflict.CreatedAt.UTC().Format("2006-01-02 15:04 UTC") }</p>
			</div>
		</div>
		<div class="caldo-conflict-comparison" data-conflict-comparison>
			<table class="caldo-conflict-table" aria-label="Feldvergleich lokaler und entfernter Konfliktversionen">
				<thead>
					<tr>
						<th scope="col">Feld</th>
						if conflictHasBase(conflict) {
							<th scope="col">Base</th>
						}
						<th scope="col">Lokal</th>
						<th scope="col">Remote</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range conflictComparisonRows(conflict) {
						<tr class={ conflictComparisonRowClass(row) } data-conflict-row-state={ conflictComparisonRowState(row) } data-conflict-field={ row.Field }>
							<th scope="row">{ row.Label }</th>
							if conflictHasBase(conflict) {
								@ConflictValueCell(row.Base)
							}
							@ConflictValueCell(row.Local)
							@ConflictValueCell(row.Remote)
						</tr>
					}
				</tbody>
			</table>
		</div>
		if conflictCanResolveExistingTask(conflict) {
			<section class="caldo-conflict-resolution" data-conflict-resolution>
				<div class="caldo-conflict-resolution-heading">
					<div>
						<h3>Konflikt lösen</h3>
						<p class="caldo-muted">Wähle eine ganze Version oder stelle die finale Aufgabe feldweise zusammen.</p>
					</div>
				</div>
				<div class="caldo-conflict-resolution-actions">
					if conflictHasLocalVersion(conflict) {
						@ConflictResolveAction(conflict, "local", "Lokale Version übernehmen", "Schreibt die lokale Version nach CalDAV.")
					}
					if conflictHasRemoteVersion(conflict) {
						@ConflictResolveAction(conflict, "remote", "Remote-Version übernehmen", "Übernimmt den entfernten Stand für diese Aufgabe.")
					}
				</div>
				if conflictCanSplit(conflict) {
					@ConflictSplitResolution(conflict)
				}
				<form
					method="post"
					action={ conflictResolvePath(conflict) }
					hx-post={ conflictResolvePath(conflict) }
					hx-swap="none"
					hx-disabled-elt="find button"
					hx-headers={ conflictResolveCSRFHeaders(ctx) }
					class="caldo-conflict-manual-form"
					data-conflict-manual-form
				>
					<input type="hidden" name="resolution" value="manual"/>
					<div class="caldo-conflict-manual-grid">
						for _, field := range conflictManualFields(conflict) {
							<fieldset class="caldo-conflict-manual-field" data-conflict-field-source={ field.Name }>
								<legend>{ field.Label }</legend>
								<div class="caldo-conflict-manual-options">
									for _, option := range field.Options {
										<label class={ conflictManualOptionClass(option) } data-conflict-source-option={ option.Value }>
											<span class="caldo-conflict-manual-choice">
												<input class="caldo-check" type="radio" name={ field.Name + "_source" } value={ option.Value } checked?={ option.Selected }/>
												<span>{ option.Label }</span>
												if option.Changed {
													<span class="caldo-conflict-change-marker">Geändert</span>
												}
											</span>
											<span class="caldo-conflict-manual-value">{ option.DisplayValue }</span>
										</label>
									}
								</div>
							</fieldset>
						}
						if len(projectOptions) > 0 {
							<label class="caldo-conflict-manual-field">
								<span>Projekt</span>
								<select class="caldo-select" name="project_id">
									for _, project := range projectOptions {
										<option value={ project.ID } selected?={ conflictProjectSelected(conflict, project) }>{ project.Name }</option>
									}
								</select>
							</label>
						}
					</div>
					<p class="caldo-alert caldo-alert-error caldo-conflict-resolution-error" data-conflict-resolution-error aria-live="polite" hidden>Konflikt konnte nicht gespeichert werden.</p>
					<div class="caldo-conflict-manual-actions">
						<button type="submit" class="caldo-button caldo-button-primary">Ausgewählte Felder speichern</button>
						<span class="htmx-indicator caldo-meta" aria-live="polite">Speichern ...</span>
					</div>
				</form>
			</section>
		} else {
			<p class="caldo-alert caldo-alert-warning" data-conflict-resolution-unavailable>Dieser Konflikt hat keine lokale Aufgabe, die sicher überschrieben werden kann.</p>
		}
		if len(conflictRawVersions(conflict)) > 0 {
			<details class="caldo-conflict-raw">
				<summary>Technische VTODO-Daten</summary>
				for _, version := range conflictRawVersions(conflict) {
					<div>
						<h3>{ version.Label }</h3>
						<pre>{ version.Raw }</pre>
					</div>
				}
			</details>
		}
	</section>
}

templ ConflictResolveAction(conflict db.ConflictDetail, resolution string, label string, hint string) {
	<form
		method="post"
		action={ conflictResolvePath(conflict) }
		hx-post={ conflictResolvePath(conflict) }
		hx-swap="none"
		hx-disabled-elt="find button"
		hx-headers={ conflictResolveCSRFHeaders(ctx) }
		class="caldo-conflict-resolve-form"
		data-conflict-resolve-form
	>
		<input type="hidden" name="resolution" value={ resolution }/>
		<button type="submit" class="caldo-button caldo-button-secondary">{ label }</button>
		<p class="caldo-conflict-resolve-hint">{ hint }</p>
	</form>
}

templ ConflictSplitResolution(conflict db.ConflictDetail) {
	<section class="caldo-conflict-split" data-conflict-split-preview>
		<div class="caldo-conflict-split-heading">
			<div>
				<h4>Beide Versionen behalten</h4>
				<p class="caldo-muted">Die lokale Aufgabe bleibt bestehen. Die Remote-Version wird als neue Aufgabe im selben Projekt ohne Parent-Verknüpfung angelegt.</p>
			</div>
		</div>
		<div class="caldo-conflict-split-preview-grid">
			@ConflictSplitPreview(conflictSplitLocalPreview(conflict))
			@ConflictSplitPreview(conflictSplitRemotePreview(conflict))
		</div>
		<form
			method="post"
			action={ conflictResolvePath(conflict) }
			hx-post={ conflictResolvePath(conflict) }
			hx-swap="none"
			hx-disabled-elt="find button"
			hx-headers={ conflictResolveCSRFHeaders(ctx) }
			class="caldo-conflict-split-form"
			data-conflict-split-form
		>
			<input type="hidden" name="resolution" value="split"/>
			<button type="submit" class="caldo-button caldo-button-secondary">Beide Versionen behalten</button>
			<span class="htmx-indicator caldo-meta" aria-live="polite">Speichern ...</span>
		</form>
	</section>
}

templ ConflictSplitPreview(preview conflictSplitPreview) {
	<div class="caldo-conflict-split-item">
		<p class="caldo-meta">{ preview.Label }</p>
		<p class="caldo-conflict-split-title">Titel: { preview.Title }</p>
		<dl class="caldo-conflict-split-meta">
			<div>
				<dt>UID</dt>
				<dd>{ preview.UID }</dd>
			</div>
			<div>
				<dt>Projekt</dt>
				<dd>{ preview.Project }</dd>
			</div>
			<div>
				<dt>Status</dt>
				<dd>{ preview.Status }</dd>
			</div>
			<div>
				<dt>Fälligkeit</dt>
				<dd>{ preview.Due }</dd>
			</div>
			<div>
				<dt>Unteraufgabe</dt>
				<dd>{ preview.Parent }</dd>
			</div>
		</dl>
	</div>
}

templ ConflictValueCell(cell conflictComparisonCell) {
	<td class={ conflictCellClass(cell) } data-conflict-value={ cell.Key }>
		<span>{ cell.Value }</span>
		if cell.Changed {
			<span class="caldo-conflict-change-marker">Geändert</span>
		}
	</td>
}
