package view

func navLinkClass(title string, activeTitles ...string) string {
	base := "caldo-nav-link"
	for _, candidate := range activeTitles {
		if title == candidate {
			return base + " caldo-nav-link-active"
		}
	}

	return base
}

templ navLink(title string, item NavigationItem) {
	<a class={ navLinkClass(title, item.ActiveTitles...) } href={ templ.URL(item.Href) }>
		<span class="caldo-nav-label">{ item.Label }</span>
		if item.HasCount {
			<span class="caldo-nav-count" aria-label={ navCountText(item.Count) + " offene Einträge" }>{ navCountText(item.Count) }</span>
		}
	</a>
}

templ navEmpty(message string) {
	<p class="caldo-nav-empty">{ message }</p>
}

templ shellNavSections(title string, nav NavigationSnapshot) {
	<section class="caldo-sidebar-section">
		<h2 class="caldo-section-title mb-2">Systemfilter</h2>
		<ul class="space-y-1" data-nav-system-filters>
			for _, item := range nav.System {
				<li>@navLink(title, item)</li>
			}
		</ul>
	</section>
	<section class="caldo-sidebar-section">
		<h2 class="caldo-section-title mb-2">Filter</h2>
		<ul class="space-y-1" data-nav-user-filters>
			<li>@navLink(title, NavigationItem{Label: "Alle Filter", Href: "/filters", ActiveTitles: []string{"Filter", "Filter"}})</li>
			if len(nav.SavedFilters) == 0 {
				<li>@navEmpty("Keine gespeicherten Filter")</li>
			} else {
				for _, item := range nav.SavedFilters {
					<li>@navLink(title, item)</li>
				}
			}
		</ul>
	</section>
	<section class="caldo-sidebar-section">
		<h2 class="caldo-section-title mb-2">Labels</h2>
		<ul class="space-y-1" data-nav-labels>
			<li>@navLink(title, NavigationItem{Label: "Alle Labels", Href: "/labels", ActiveTitles: []string{"Labels"}})</li>
			if len(nav.Labels) == 0 {
				<li>@navEmpty("Keine Labels")</li>
			} else {
				for _, item := range nav.Labels {
					<li>@navLink(title, item)</li>
				}
			}
		</ul>
	</section>
	<section class="caldo-sidebar-section">
		<h2 class="caldo-section-title mb-2">Projekte</h2>
		<ul class="space-y-1" data-nav-projects>
			<li>@navLink(title, NavigationItem{Label: "Alle Projekte", Href: "/projects", ActiveTitles: []string{"Projekte"}})</li>
			if len(nav.Projects) == 0 {
				<li>@navEmpty("Keine Projekte")</li>
			} else {
				for _, item := range nav.Projects {
					<li>@navLink(title, item)</li>
				}
			}
		</ul>
	</section>
}

templ BaseLayout(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="de" data-theme-root>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<meta name="csrf-token" content={ CSRFToken(ctx) }/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<link rel="stylesheet" href={ AssetPath(ctx, "app.css") }/>
		</head>
		<body class="min-h-screen">
			<div class="caldo-app-shell">
				<aside class="caldo-sidebar">
					<div class="caldo-sidebar-header">
						<a href="/today" class="caldo-brand">Caldo</a>
						<p class="caldo-meta mt-1">CalDAV-Aufgaben</p>
					</div>
					<a href="/quick-add" class="caldo-button caldo-button-primary w-full">Neue Aufgabe</a>
					<nav class="caldo-sidebar-nav" aria-label="Hauptnavigation">
						@shellNavSections(title, Navigation(ctx))
					</nav>
				</aside>
				<div class="caldo-workspace">
					<header class="caldo-topbar">
						<div class="caldo-topbar-primary">
							<button type="button" class="caldo-icon-button caldo-mobile-nav-trigger" data-mobile-nav-open aria-controls="mobile-navigation" aria-haspopup="dialog" aria-label="Navigation öffnen">
								<span class="caldo-menu-icon" aria-hidden="true"></span>
							</button>
							<div class="caldo-topbar-title">
								<p class="caldo-topbar-kicker">Aktuelle Ansicht</p>
								<p class="caldo-topbar-heading">{ title }</p>
							</div>
						</div>
						<div class="caldo-topbar-actions">
							<a href="/search" class="caldo-button caldo-button-secondary">Suche</a>
							<a href="/quick-add" class="caldo-button caldo-button-primary">Neue Aufgabe</a>
							@SyncStatusBadge("idle", "nie")
							<button type="button" data-theme-toggle class="caldo-button caldo-button-ghost">Dark Mode</button>
						</div>
					</header>
					<main class="caldo-main">
						<div class="caldo-content">
							@content
						</div>
					</main>
				</div>
			</div>
			<dialog id="mobile-navigation" data-mobile-nav-dialog class="caldo-mobile-nav-dialog" aria-label="Navigation">
				<div class="caldo-mobile-nav-panel">
					<div class="caldo-mobile-nav-header">
						<div class="min-w-0">
							<a href="/today" class="caldo-brand">Caldo</a>
							<p class="caldo-meta mt-1">CalDAV-Aufgaben</p>
						</div>
						<button type="button" data-mobile-nav-close class="caldo-button caldo-button-ghost">Schließen</button>
					</div>
					<a href="/quick-add" class="caldo-button caldo-button-primary w-full">Neue Aufgabe</a>
					<nav class="caldo-mobile-nav" aria-label="Mobile Hauptnavigation">
						@shellNavSections(title, Navigation(ctx))
					</nav>
				</div>
			</dialog>
			<div id="write-status" class="hidden caldo-toast" aria-live="polite"></div>
			<div id="notifications" aria-live="polite"></div>
			<dialog data-shortcut-help-dialog class="caldo-dialog">
				<div class="p-4 space-y-3">
					<div class="flex items-center justify-between">
						<h2 class="caldo-page-title">Tastaturkürzel</h2>
						<button type="button" data-shortcut-help-close class="caldo-button caldo-button-ghost">Schließen</button>
					</div>
					<ul class="caldo-menu">
						<li class="caldo-menu-item"><kbd class="caldo-kbd">N</kbd> Neue Aufgabe</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">S</kbd> oder <kbd class="caldo-kbd">/</kbd> Suche</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">G</kbd> dann <kbd class="caldo-kbd">T</kbd> Heute</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">G</kbd> dann <kbd class="caldo-kbd">U</kbd> Demnächst</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">?</kbd> Hilfe öffnen</li>
					</ul>
				</div>
			</dialog>

			<script defer src={ AssetPath(ctx, "htmx.min.js") }></script>
			<script defer src={ AssetPath(ctx, "htmx-sse.js") }></script>
			<script defer src={ AssetPath(ctx, "alpine.min.js") }></script>
			<script defer src={ AssetPath(ctx, "app.js") }></script>
		</body>
	</html>
}

templ EmptyContent() {
	<section></section>
}

templ PlaceholderPage(title string) {
	<section class="caldo-page">
		<h2 class="caldo-page-title">{ title }</h2>
	</section>
}
