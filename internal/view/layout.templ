package view

func navLinkClass(title string, item NavigationItem) string {
	base := "caldo-nav-link"
	if navLinkActive(title, item) {
		return base + " caldo-nav-link-active"
	}

	return base
}

func navLinkActive(title string, item NavigationItem) bool {
	if item.Active {
		return true
	}
	for _, candidate := range item.ActiveTitles {
		if title == candidate {
			return true
		}
	}

	return false
}

func navCurrentAttributes(title string, item NavigationItem) templ.Attributes {
	if navLinkActive(title, item) {
		return templ.Attributes{"aria-current": "page"}
	}

	return nil
}

templ navLink(title string, item NavigationItem) {
	<a
		class={ navLinkClass(title, item) }
		href={ templ.URL(item.Href) }
		{ navProjectDropAttributes(item)... }
		{ navCurrentAttributes(title, item)... }
	>
		<span class="caldo-nav-label">{ item.Label }</span>
		if item.HasCount {
			<span class="caldo-nav-count" aria-label={ navCountText(item.Count) + " " + Text(ctx).OpenItemsAria }>{ navCountText(item.Count) }</span>
		}
	</a>
}

templ navEmpty(message string) {
	<p class="caldo-nav-empty">{ message }</p>
}

templ shellNavSections(title string, nav NavigationSnapshot) {
	<section class="caldo-sidebar-section">
		<h2 class="caldo-section-title mb-2">{ Text(ctx).SystemFilters }</h2>
		<ul class="space-y-1" data-nav-system-filters>
			for _, item := range nav.System {
				<li>@navLink(title, item)</li>
			}
		</ul>
	</section>
	<section class="caldo-sidebar-section">
		<h2 class="caldo-section-title mb-2">{ Text(ctx).Filters }</h2>
		<ul class="space-y-1" data-nav-user-filters>
			<li>@navLink(title, NavigationItem{Label: Text(ctx).AllFilters, Href: "/filters", ActiveTitles: []string{"Filter", Text(ctx).Filters}})</li>
			if len(nav.SavedFilters) == 0 {
				<li>@navEmpty(Text(ctx).NoSavedFilters)</li>
			} else {
				for _, item := range nav.SavedFilters {
					<li>@navLink(title, item)</li>
				}
			}
		</ul>
	</section>
	<section class="caldo-sidebar-section">
		<h2 class="caldo-section-title mb-2">{ Text(ctx).Labels }</h2>
		<ul class="space-y-1" data-nav-labels>
			<li>@navLink(title, NavigationItem{Label: Text(ctx).AllLabels, Href: "/labels", ActiveTitles: []string{"Labels", Text(ctx).Labels}})</li>
			if len(nav.Labels) == 0 {
				<li>@navEmpty(Text(ctx).NoLabels)</li>
			} else {
				for _, item := range nav.Labels {
					<li>@navLink(title, item)</li>
				}
			}
		</ul>
	</section>
	<section class="caldo-sidebar-section">
		<h2 class="caldo-section-title mb-2">{ Text(ctx).Projects }</h2>
		<ul class="caldo-sidebar-project-list space-y-1" data-nav-projects tabindex="0" aria-label={ Text(ctx).Projects }>
			<li>@navLink(title, NavigationItem{Label: Text(ctx).AllProjects, Href: "/projects", ActiveTitles: []string{"Projekte", Text(ctx).Projects}})</li>
			if len(nav.Projects) == 0 {
				<li>@navEmpty(Text(ctx).NoProjects)</li>
			} else {
				for _, item := range nav.Projects {
					<li>@navLink(title, item)</li>
				}
			}
		</ul>
	</section>
}

templ shellSettingsNav(title string) {
	<nav class="caldo-sidebar-settings" aria-label={ Text(ctx).Settings } data-nav-settings>
		<ul class="space-y-1">
			<li>@navLink(title, settingsNavigationItem(Text(ctx)))</li>
		</ul>
	</nav>
}

templ BaseLayout(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ UILanguage(ctx) } data-theme-root data-theme-mode={ UIDarkMode(ctx) } class={ ThemeRootClass(ctx) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ DisplayTitle(ctx, title) }</title>
			<meta name="csrf-token" content={ CSRFToken(ctx) }/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false,"attributesToSettle":["class","width","height"]}'/>
			<link rel="stylesheet" href={ AssetPath(ctx, "app.css") }/>
		</head>
		<body class="min-h-screen">
			<div class="caldo-app-shell">
				<aside class="caldo-sidebar">
					<div class="caldo-sidebar-header">
						<a href="/today" class="caldo-brand">Caldo</a>
					</div>
					<a href="/quick-add" class="caldo-button caldo-button-primary w-full" data-quick-add-open aria-controls="quick-add-overlay" aria-haspopup="dialog">{ Text(ctx).NewTask }</a>
					<nav class="caldo-sidebar-nav" aria-label={ Text(ctx).MainNavigation }>
						@shellNavSections(title, Navigation(ctx))
					</nav>
					@shellSettingsNav(title)
				</aside>
				<div class="caldo-workspace">
					<header class="caldo-topbar">
						<div class="caldo-topbar-primary">
							<button type="button" class="caldo-icon-button caldo-mobile-nav-trigger" data-mobile-nav-open aria-controls="mobile-navigation" aria-haspopup="dialog" aria-expanded="false" aria-label={ Text(ctx).OpenNavigation }>
								<span class="caldo-menu-icon" aria-hidden="true"></span>
							</button>
							<div class="caldo-topbar-title">
								<p class="caldo-topbar-kicker">{ Text(ctx).CurrentView }</p>
								<h1 class="caldo-topbar-heading">{ DisplayTitle(ctx, title) }</h1>
							</div>
						</div>
						<div class="caldo-topbar-actions">
							<a href="/search" class="caldo-icon-button" aria-label={ Text(ctx).Search }>
								<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
									<circle cx="11" cy="11" r="8"></circle>
									<path d="m21 21-4.3-4.3"></path>
								</svg>
							</a>
							<a href="/quick-add" class="caldo-button caldo-button-primary" data-quick-add-open aria-controls="quick-add-overlay" aria-haspopup="dialog">{ Text(ctx).NewTask }</a>
							@SyncStatusFrame(CurrentSyncStatus(ctx).State, CurrentSyncStatus(ctx).LastSuccess)
							<button
								type="button"
								data-theme-toggle
								data-theme-mode={ UIDarkMode(ctx) }
								data-theme-label-prefix={ Text(ctx).ThemeSettings }
								data-theme-system-label={ Text(ctx).ThemeSystem }
								data-theme-light-label={ Text(ctx).ThemeLight }
								data-theme-dark-label={ Text(ctx).ThemeDark }
								class="caldo-icon-button caldo-button-ghost caldo-theme-toggle"
								aria-label={ Text(ctx).ThemeSettings + ": " + ThemeModeLabel(ctx, UIDarkMode(ctx)) }
								title={ Text(ctx).ThemeSettings + ": " + ThemeModeLabel(ctx, UIDarkMode(ctx)) }
							>
								<span class="caldo-theme-icon caldo-theme-icon-system" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
										<rect x="3" y="4" width="18" height="12" rx="2"></rect>
										<path d="M8 20h8"></path>
										<path d="M12 16v4"></path>
									</svg>
								</span>
								<span class="caldo-theme-icon caldo-theme-icon-dark" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
										<path d="M20.99 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 20.99 12.79z"></path>
									</svg>
								</span>
								<span class="caldo-theme-icon caldo-theme-icon-light" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
										<circle cx="12" cy="12" r="4"></circle>
										<path d="M12 2v2"></path>
										<path d="M12 20v2"></path>
										<path d="m4.93 4.93 1.41 1.41"></path>
										<path d="m17.66 17.66 1.41 1.41"></path>
										<path d="M2 12h2"></path>
										<path d="M20 12h2"></path>
										<path d="m6.34 17.66-1.41 1.41"></path>
										<path d="m19.07 4.93-1.41 1.41"></path>
									</svg>
								</span>
								<span class="sr-only" data-theme-current-label>{ Text(ctx).ThemeSettings }: { ThemeModeLabel(ctx, UIDarkMode(ctx)) }</span>
							</button>
						</div>
					</header>
					<main class="caldo-main">
						<div class="caldo-content">
							@content
						</div>
					</main>
				</div>
			</div>
			<dialog id="mobile-navigation" data-mobile-nav-dialog class="caldo-mobile-nav-dialog" aria-label={ Text(ctx).OpenNavigation }>
				<div class="caldo-mobile-nav-panel">
					<div class="caldo-mobile-nav-header">
						<div class="min-w-0">
							<a href="/today" class="caldo-brand">Caldo</a>
						</div>
						<button type="button" data-mobile-nav-close class="caldo-icon-button" aria-label={ Text(ctx).Close }>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
								<path d="M18 6 6 18"></path>
								<path d="m6 6 12 12"></path>
							</svg>
						</button>
					</div>
					<a href="/quick-add" class="caldo-button caldo-button-primary w-full" data-quick-add-open aria-controls="quick-add-overlay" aria-haspopup="dialog">{ Text(ctx).NewTask }</a>
					<nav class="caldo-mobile-nav" aria-label={ Text(ctx).MobileMainNavigation }>
						@shellNavSections(title, Navigation(ctx))
					</nav>
					@shellSettingsNav(title)
				</div>
			</dialog>
			@QuickAddOverlay()
			<div id="write-status" data-write-status class="hidden caldo-toast" role="status" aria-live="polite"></div>
			<div id="notifications" data-toast-container aria-live="polite"></div>
			<dialog data-shortcut-help-dialog class="caldo-dialog" aria-labelledby="shortcut-help-title">
				<div class="p-4 space-y-3">
					<div class="flex items-center justify-between">
						<h2 id="shortcut-help-title" class="caldo-page-title">{ Text(ctx).ShortcutHelp }</h2>
						<button type="button" data-shortcut-help-close class="caldo-icon-button" aria-label={ Text(ctx).Close }>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
								<path d="M18 6 6 18"></path>
								<path d="m6 6 12 12"></path>
							</svg>
						</button>
					</div>
					<ul class="caldo-menu grid grid-cols-1 sm:grid-cols-2 gap-0.5">
						<li class="caldo-menu-item"><kbd class="caldo-kbd">N</kbd> { Text(ctx).ShortcutNewTask }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">D</kbd> { Text(ctx).ShortcutDueDate }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">S</kbd> { Text(ctx).Or } <kbd class="caldo-kbd">/</kbd> { Text(ctx).ShortcutSearch }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">G</kbd> { Text(ctx).Then } <kbd class="caldo-kbd">T</kbd> { Text(ctx).ShortcutToday }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">G</kbd> { Text(ctx).Then } <kbd class="caldo-kbd">U</kbd> { Text(ctx).ShortcutUpcoming }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">G</kbd> { Text(ctx).Then } <kbd class="caldo-kbd">V</kbd> { Text(ctx).ShortcutFavorites }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">G</kbd> { Text(ctx).Then } <kbd class="caldo-kbd">P</kbd> { Text(ctx).ShortcutProjects }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">G</kbd> { Text(ctx).Then } <kbd class="caldo-kbd">L</kbd> { Text(ctx).ShortcutLabels }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">G</kbd> { Text(ctx).Then } <kbd class="caldo-kbd">F</kbd> { Text(ctx).ShortcutFilters }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">G</kbd> { Text(ctx).Then } <kbd class="caldo-kbd">C</kbd> { Text(ctx).ShortcutConflicts }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">G</kbd> { Text(ctx).Then } <kbd class="caldo-kbd">E</kbd> { Text(ctx).ShortcutSettings }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">R</kbd> { Text(ctx).ShortcutSyncNow }</li>
						<li class="caldo-menu-item"><kbd class="caldo-kbd">?</kbd> { Text(ctx).ShortcutOpenHelp }</li>
					</ul>
				</div>
			</dialog>

			<script defer src={ AssetPath(ctx, "htmx.min.js") }></script>
			<script defer src={ AssetPath(ctx, "htmx-sse.js") }></script>
			<script defer src={ AssetPath(ctx, "alpine.min.js") }></script>
			<script defer src={ AssetPath(ctx, "app.js") }></script>
		</body>
	</html>
}

templ EmptyContent() {
	<section></section>
}

templ PlaceholderPage(title string) {
	<section class="caldo-page">
		<h2 class="caldo-page-title">{ title }</h2>
	</section>
}
