package view

templ ProjectsOverviewPage(items []NavigationOverviewItem, feedback ProjectFeedback) {
	<section class="caldo-page">
		<h2 class="caldo-page-title">Projekte</h2>
		if feedback.PageSuccess != "" {
			<p class="caldo-alert caldo-alert-success" data-project-page-success aria-live="polite">{ feedback.PageSuccess }</p>
		}
		@ProjectCreateForm(feedback)
		if len(items) == 0 {
			@EmptyState("Keine Projekte", "Die Gruppe ist eingerichtet, enthält aber noch keine Einträge.")
		} else {
			@NavigationOverviewList(items)
		}
	</section>
}

templ ProjectCreateForm(feedback ProjectFeedback) {
	<form
		class="caldo-card space-y-3"
		method="post"
		action="/projects"
		hx-post="/projects"
		hx-target="body"
		hx-swap="outerHTML"
		hx-push-url="false"
		hx-disabled-elt="find button"
		hx-headers={ "{\"X-CSRF-Token\":\"" + CSRFToken(ctx) + "\"}" }
		data-project-create-form
	>
		<h3 class="font-medium">Neues Projekt</h3>
		if feedback.CreateSuccess != "" {
			<p class="caldo-alert caldo-alert-success" data-project-create-success aria-live="polite">{ feedback.CreateSuccess }</p>
		}
		if feedback.CreateError != "" {
			<p class="caldo-alert caldo-alert-error" data-project-create-error aria-live="polite">{ feedback.CreateError }</p>
		}
		<label class="caldo-label" for="project-create-display-name">Projektname</label>
		<div class="flex flex-col gap-2 sm:flex-row sm:items-center">
			<input id="project-create-display-name" class="caldo-input sm:max-w-sm" type="text" name="display_name" value={ feedback.CreateValue } autocomplete="off" required data-project-create-name/>
			<button type="submit" class="caldo-button caldo-button-primary">Projekt anlegen</button>
			<span class="htmx-indicator caldo-meta" aria-live="polite">Speichern ...</span>
		</div>
	</form>
}

templ NavigationOverviewPage(heading string, emptyTitle string, items []NavigationOverviewItem) {
	<section class="caldo-page">
		<h2 class="caldo-page-title">{ heading }</h2>
		if len(items) == 0 {
			@EmptyState(emptyTitle, "Die Gruppe ist eingerichtet, enthält aber noch keine Einträge.")
		} else {
			@NavigationOverviewList(items)
		}
	</section>
}

templ NavigationOverviewList(items []NavigationOverviewItem) {
	<ul class="caldo-list" data-navigation-overview>
		for _, item := range items {
			<li
				class="caldo-list-row"
				{ projectDropAttributes(item)... }
			>
				<div class="space-y-3">
					<div>
						<a class="caldo-list-link" href={ templ.URL(item.Href) }>{ item.Name }</a>
						<p class="caldo-meta mt-1">
							{ item.Meta }
							if item.HasCount {
								 · { navCountText(item.Count) } offen
							}
						</p>
					</div>
					if projectCanRename(item) {
						@ProjectRenameForm(item)
					}
					if projectCanDelete(item) {
						@ProjectDeleteForm(item)
					}
				</div>
			</li>
		}
	</ul>
}

templ ProjectRenameForm(item NavigationOverviewItem) {
	<form
		class="space-y-2"
		method="post"
		action={ projectRenamePath(item) }
		hx-patch={ projectRenamePath(item) }
		hx-target="body"
		hx-swap="outerHTML"
		hx-push-url="false"
		hx-disabled-elt="find button"
		hx-headers={ "{\"X-CSRF-Token\":\"" + CSRFToken(ctx) + "\"}" }
		data-project-rename-form
	>
		<input type="hidden" name="expected_version" value={ projectExpectedVersion(item) }/>
		if item.RenameSuccess != "" {
			<p class="caldo-alert caldo-alert-success" data-project-rename-success aria-live="polite">{ item.RenameSuccess }</p>
		}
		if item.RenameError != "" {
			<p class="caldo-alert caldo-alert-error" data-project-rename-error aria-live="polite">{ item.RenameError }</p>
		}
		<label class="caldo-label" for={ "project-rename-" + item.ID }>Projekt umbenennen</label>
		<div class="flex flex-col gap-2 sm:flex-row sm:items-center">
			<input id={ "project-rename-" + item.ID } class="caldo-input sm:max-w-sm" type="text" name="display_name" value={ projectRenameValue(item) } autocomplete="off" required data-project-rename-name/>
			<button type="submit" class="caldo-button caldo-button-secondary">Umbenennen</button>
			<span class="htmx-indicator caldo-meta" aria-live="polite">Speichern ...</span>
		</div>
	</form>
}

templ ProjectDeleteForm(item NavigationOverviewItem) {
	<details class="space-y-2" open?={ item.DeleteError != "" } data-project-delete-panel>
		<summary class="caldo-button caldo-button-danger">Projekt löschen</summary>
		<form
			class="space-y-2"
			method="post"
			action={ projectDeletePath(item) }
			hx-delete={ projectDeletePath(item) }
			hx-target="body"
			hx-swap="outerHTML"
			hx-push-url="false"
			hx-disabled-elt="find button"
			hx-headers={ "{\"X-CSRF-Token\":\"" + CSRFToken(ctx) + "\"}" }
			data-project-delete-form
		>
			<input type="hidden" name="expected_version" value={ projectExpectedVersion(item) }/>
			if item.DeleteError != "" {
				<p class="caldo-alert caldo-alert-error" data-project-delete-error aria-live="polite">{ item.DeleteError }</p>
			}
			<p class="caldo-meta" data-project-delete-summary>{ projectDeleteConfirmationText(item) }</p>
			<label class="caldo-label" for={ "project-delete-" + item.ID }>Bestätigung</label>
			<div class="flex flex-col gap-2 sm:flex-row sm:items-center">
				<input id={ "project-delete-" + item.ID } class="caldo-input sm:max-w-sm" type="text" name="confirmation_name" value={ projectDeleteValue(item) } autocomplete="off" required data-project-delete-confirmation/>
				<button type="submit" class="caldo-button caldo-button-danger-solid">Endgültig löschen</button>
				<span class="htmx-indicator caldo-meta" aria-live="polite">Löscht ...</span>
			</div>
		</form>
	</details>
}
