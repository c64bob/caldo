package view

import (
	"strings"

	"caldo/internal/parser"
)

templ QuickAddPage(draft *parser.QuickAddDraft, text string, errorMessage string) {
	<section class="caldo-page caldo-quick-add">
		<h2 class="caldo-page-title">{ Text(ctx).QuickAddTitle }</h2>
		<form
			method="post"
			action="/quick-add/preview"
			hx-post="/quick-add/preview"
			hx-target="#quick-add-preview"
			hx-trigger="input changed delay:350ms, submit"
			hx-swap="outerHTML"
			hx-disabled-elt="find button"
			class="caldo-quick-add-form"
		>
			<label for="quick-add-text" class="caldo-label">{ Text(ctx).QuickAddTaskLabel }</label>
			<input id="quick-add-text" name="text" type="text" class="caldo-input" autofocus value={ text }/>
			<div class="caldo-quick-add-actions">
				<button type="submit" accesskey="q" class="caldo-button caldo-button-secondary">{ Text(ctx).QuickAddPreviewAction }</button>
				<span class="htmx-indicator caldo-meta" aria-live="polite">{ Text(ctx).QuickAddPreviewPending }</span>
			</div>
		</form>
		<div id="quick-add-preview" class="caldo-quick-add-preview-shell">
			if errorMessage != "" {
				<p class="caldo-alert caldo-alert-error">{ errorMessage }</p>
			}
			if draft != nil {
				@quickAddPreviewContent(*draft, "quick-add-preview", "")
			}
		</div>
	</section>
}

templ QuickAddOverlay() {
	<dialog id="quick-add-overlay" class="caldo-quick-add-overlay" data-quick-add-overlay aria-labelledby="quick-add-overlay-title">
		<div class="caldo-quick-add-overlay-panel">
			<div class="caldo-quick-add-overlay-header">
				<h2 id="quick-add-overlay-title" class="caldo-page-title">{ Text(ctx).QuickAddTitle }</h2>
				<button type="button" class="caldo-button caldo-button-ghost" data-quick-add-close>{ Text(ctx).Close }</button>
			</div>
			<div class="caldo-quick-add-overlay-body">
				<form
					method="post"
					action="/quick-add/preview"
					hx-post="/quick-add/preview"
					hx-target="#quick-add-overlay-preview"
					hx-trigger="input changed delay:350ms, submit"
					hx-swap="outerHTML"
					hx-disabled-elt="find button"
					class="caldo-quick-add-form"
					data-quick-add-overlay-form
				>
					<input type="hidden" name="surface" value={ quickAddOverlaySurface }/>
					<label for="quick-add-overlay-text" class="caldo-label">{ Text(ctx).QuickAddTaskLabel }</label>
					<input id="quick-add-overlay-text" name="text" type="text" class="caldo-input" data-quick-add-overlay-input/>
					<div class="caldo-quick-add-actions">
						<button type="submit" accesskey="q" class="caldo-button caldo-button-secondary">{ Text(ctx).QuickAddPreviewAction }</button>
						<span class="htmx-indicator caldo-meta" aria-live="polite">{ Text(ctx).QuickAddPreviewPending }</span>
					</div>
				</form>
				<p class="caldo-alert caldo-alert-error" data-quick-add-overlay-error hidden></p>
				<div id="quick-add-overlay-preview" class="caldo-quick-add-preview-shell"></div>
			</div>
		</div>
	</dialog>
}

templ QuickAddPreview(draft parser.QuickAddDraft, text string) {
	@quickAddPreviewContent(draft, "quick-add-preview", "")
}

templ QuickAddOverlayPreview(draft parser.QuickAddDraft, text string) {
	@quickAddPreviewContent(draft, "quick-add-overlay-preview", quickAddOverlaySurface)
}

templ quickAddPreviewContent(draft parser.QuickAddDraft, previewID string, surface string) {
	<section id={ previewID } class="caldo-card caldo-quick-add-preview" data-quick-add-preview>
		<h3>{ Text(ctx).QuickAddPreviewHeading }</h3>
		if quickAddHasRecognizedTokens(draft) {
			<div class="caldo-quick-add-chips" data-quick-add-chips>
				if strings.TrimSpace(draft.Project) != "" {
					if draft.ProjectNew {
						<button type="button" class="caldo-quick-add-chip" data-quick-add-clear="[name='project_new_name']">
							<span>{ Text(ctx).QuickAddFieldProject }</span>
							<strong>{ draft.Project }</strong>
						</button>
					} else {
						<button type="button" class="caldo-quick-add-chip" data-quick-add-clear="[name='project_selection']">
							<span>{ Text(ctx).QuickAddFieldProject }</span>
							<strong>{ draft.Project }</strong>
						</button>
					}
				}
				for _, label := range draft.Labels {
					<button type="button" class="caldo-quick-add-chip" data-quick-add-remove-label={ label }>
						<span>{ Text(ctx).QuickAddFieldLabels }</span>
						<strong>{ label }</strong>
						<span class="caldo-badge">{ quickAddLabelStatus(ctx, draft, label) }</span>
					</button>
				}
				if strings.TrimSpace(draft.Due) != "" {
					<button type="button" class="caldo-quick-add-chip" data-quick-add-clear="[name='due_date']">
						<span>{ Text(ctx).QuickAddFieldDate }</span>
						<strong>{ quickAddDueChipLabel(draft) }</strong>
					</button>
				}
				if strings.TrimSpace(draft.Recurrence) != "" {
					<button type="button" class="caldo-quick-add-chip" data-quick-add-clear="[name='recurrence']">
						<span>{ Text(ctx).QuickAddFieldRecurrence }</span>
						<strong>{ quickAddRecurrenceLabel(ctx, draft.Recurrence) }</strong>
					</button>
				}
				if strings.TrimSpace(draft.Priority) != "" {
					<button type="button" class={ quickAddPriorityChipClass(draft.Priority) } data-quick-add-clear="[name='priority']">
						<span>{ Text(ctx).QuickAddFieldPriority }</span>
						<strong>{ quickAddPriorityLabel(ctx, draft.Priority) }</strong>
					</button>
				}
			</div>
		}
		<dl class="caldo-quick-add-preview-grid">
			<div>
				<dt>{ Text(ctx).QuickAddFieldTitle }</dt>
				<dd>{ draft.Title }</dd>
			</div>
			<div>
				<dt>{ Text(ctx).QuickAddFieldProject }</dt>
				<dd>
					<span>{ quickAddProjectLabel(ctx, draft) }</span>
					<span class="caldo-badge">{ quickAddProjectStatus(ctx, draft) }</span>
				</dd>
			</div>
			<div>
				<dt>{ Text(ctx).QuickAddFieldLabels }</dt>
				<dd>{ quickAddDisplayValue(ctx, quickAddLabelsValue(draft)) }</dd>
			</div>
			<div>
				<dt>{ Text(ctx).QuickAddFieldDate }</dt>
				<dd>{ quickAddDisplayValue(ctx, draft.Due) }</dd>
			</div>
			<div>
				<dt>{ Text(ctx).QuickAddFieldRecurrence }</dt>
				<dd>{ quickAddRecurrenceDisplayValue(ctx, draft.Recurrence) }</dd>
			</div>
			<div>
				<dt>{ Text(ctx).QuickAddFieldPriority }</dt>
				<dd>{ quickAddPriorityLabel(ctx, draft.Priority) }</dd>
			</div>
		</dl>
		<form
			method="post"
			action="/tasks"
			hx-post="/tasks"
			hx-disabled-elt="find button"
			hx-headers={ quickAddCSRFHeaders(ctx) }
			class="caldo-quick-add-save-form"
			data-quick-add-save-form
			{ quickAddOverlayAttributes(surface)... }
		>
			<div class="caldo-quick-add-corrections" data-quick-add-corrections>
				<label class="caldo-label">
					{ Text(ctx).QuickAddFieldTitle }
					<input class="caldo-input" type="text" name="title" value={ draft.Title } data-quick-add-correction="title"/>
				</label>
				if draft.ProjectNew {
					<label class="caldo-label">
						{ Text(ctx).QuickAddFieldProject }
						<input class="caldo-input" type="text" name="project_new_name" value={ draft.Project } data-quick-add-correction="project"/>
					</label>
					<fieldset class="caldo-quick-add-project-options" data-quick-add-project-suggestions>
						<legend>{ Text(ctx).QuickAddProjectList }</legend>
						if len(draft.ProjectSuggestions) > 0 {
							for _, suggestion := range draft.ProjectSuggestions {
								<label class="caldo-quick-add-project-option" data-quick-add-project-suggestion>
									<input class="caldo-check" type="radio" name="project_selection" value={ "existing:" + suggestion.ID } required/>
									<span>{ suggestion.Name }</span>
									<span class="caldo-badge">{ Text(ctx).QuickAddFound }</span>
								</label>
							}
						}
						<label class="caldo-quick-add-project-option">
							<input class="caldo-check" type="radio" name="project_selection" value="create" required/>
							<span>{ Text(ctx).QuickAddFieldProject } "{ draft.Project }" { Text(ctx).QuickAddCreateProject }</span>
							<span class="caldo-badge caldo-badge-accent">{ Text(ctx).QuickAddCreateNew }</span>
						</label>
					</fieldset>
				} else if len(draft.ProjectOptions) > 0 {
					<label class="caldo-label">
						{ Text(ctx).QuickAddFieldProject }
						<select class="caldo-select" name="project_selection" data-quick-add-correction="project">
							<option value="">{ Text(ctx).QuickAddDefaultProject }</option>
							for _, project := range draft.ProjectOptions {
								<option value={ quickAddSelectProjectValue(project.ID) } selected?={ quickAddProjectSelected(draft, project.ID) }>{ project.Name }</option>
							}
						</select>
					</label>
				} else {
					<input type="hidden" name="project_id" value={ draft.ProjectID }/>
				}
				<label class="caldo-label">
					{ Text(ctx).QuickAddFieldLabels }
					<div class="caldo-quick-add-correction-row">
						<input class="caldo-input" type="text" name="labels" value={ quickAddLabelsValue(draft) } list={ quickAddLabelDatalistID(previewID) } data-quick-add-correction="labels" data-quick-add-labels-input/>
						<button type="button" class="caldo-button caldo-button-ghost" data-quick-add-clear="[name='labels']">{ Text(ctx).QuickAddClearValue }</button>
					</div>
					if len(draft.LabelOptions) > 0 {
						<datalist id={ quickAddLabelDatalistID(previewID) }>
							for _, label := range draft.LabelOptions {
								<option value={ label.Name }></option>
							}
						</datalist>
					}
					if quickAddHasLabelSuggestions(draft) {
						<div class="caldo-quick-add-suggestions" data-quick-add-label-suggestions>
							<span class="caldo-meta">{ Text(ctx).QuickAddLabelSuggestions }</span>
							<div class="caldo-quick-add-suggestion-list">
								for _, suggestion := range quickAddLabelSuggestions(draft) {
									<button type="button" class="caldo-quick-add-suggestion" data-quick-add-append-label={ suggestion.Name }>{ "@" + suggestion.Name }</button>
								}
							</div>
						</div>
					}
				</label>
				<label class="caldo-label">
					{ Text(ctx).QuickAddFieldDate }
					if strings.TrimSpace(draft.Due) != "" {
						<div class="caldo-quick-add-date-preview" data-quick-add-date-resolution>
							<span class="caldo-meta">{ Text(ctx).QuickAddDateResolved }</span>
							<strong>{ draft.Due }</strong>
							if strings.TrimSpace(draft.DueSource) != "" {
								<span class="caldo-quick-add-date-source">{ draft.DueSource }</span>
							}
							if draft.DueAmbiguous {
								<span class="caldo-badge caldo-badge-warning" data-quick-add-date-warning>{ Text(ctx).QuickAddDateReviewHint }</span>
							}
						</div>
					}
					<div class="caldo-quick-add-correction-row">
						<input class="caldo-input" type="date" name="due_date" value={ draft.Due } data-quick-add-correction="due"/>
						<button type="button" class="caldo-button caldo-button-ghost" data-quick-add-clear="[name='due_date']">{ Text(ctx).QuickAddClearValue }</button>
					</div>
				</label>
				<label class="caldo-label">
					{ Text(ctx).QuickAddFieldRecurrence }
					<div class="caldo-quick-add-correction-row">
						<input
							class="caldo-input"
							type="text"
							name="recurrence"
							value={ draft.Recurrence }
							aria-describedby={ previewID + "-recurrence-error" }
							data-quick-add-correction="recurrence"
							data-quick-add-recurrence-input
						/>
						<button type="button" class="caldo-button caldo-button-ghost" data-quick-add-clear="[name='recurrence']">{ Text(ctx).QuickAddClearValue }</button>
					</div>
					<p id={ previewID + "-recurrence-error" } class="caldo-quick-add-field-error" data-quick-add-recurrence-error hidden>{ Text(ctx).QuickAddRRuleInvalid }</p>
				</label>
				<label class="caldo-label">
					{ Text(ctx).QuickAddFieldPriority }
					<div class="caldo-quick-add-correction-row">
						<select class="caldo-select" name="priority" data-quick-add-correction="priority">
							<option value="" selected?={ strings.TrimSpace(draft.Priority) == "" }>{ Text(ctx).None }</option>
							for _, priority := range quickAddPriorityOptions(ctx) {
								<option value={ priority.Value } selected?={ strings.TrimSpace(draft.Priority) == priority.Value }>{ priority.Label }</option>
							}
						</select>
						<button type="button" class="caldo-button caldo-button-ghost" data-quick-add-clear="[name='priority']">{ Text(ctx).QuickAddClearValue }</button>
					</div>
				</label>
			</div>
			<div class="caldo-quick-add-actions">
				<button type="submit" class="caldo-button caldo-button-primary">{ Text(ctx).QuickAddSaveAction }</button>
				<span class="htmx-indicator caldo-meta" aria-live="polite">{ Text(ctx).QuickAddSavePending }</span>
			</div>
		</form>
	</section>
}
