package view

templ SavedFiltersPage(filters []SavedFilterItemView, create SavedFilterCreateFormView) {
	<section class="caldo-page">
		@SavedFilterCreateForm(create)
		if len(filters) == 0 {
			@EmptyState("Keine gespeicherten Filter", "Die Gruppe ist eingerichtet, enthält aber noch keine Einträge.")
		} else {
			<ul class="caldo-list" data-saved-filter-list>
				for _, item := range filters {
					@SavedFilterRow(item)
				}
			</ul>
		}
	</section>
}

templ SavedFilterCreateForm(create SavedFilterCreateFormView) {
	<form
		class="caldo-card space-y-3"
		method="post"
		action="/filters"
		hx-post="/filters"
		hx-target="body"
		hx-swap="outerHTML"
		hx-push-url="false"
		hx-disabled-elt="find button"
		hx-headers={ "{\"X-CSRF-Token\":\"" + CSRFToken(ctx) + "\"}" }
		data-saved-filter-create-form
	>
		<h3 class="font-medium">Neuer Filter</h3>
		if create.Error != "" {
			<p class="caldo-alert caldo-alert-error" data-saved-filter-create-error role="alert" aria-live="polite">{ create.Error }</p>
		}
		<div class="caldo-filter-help-scope" data-filter-help-scope>
			<div class="grid gap-3 lg:grid-cols-[minmax(12rem,18rem)_1fr_auto] lg:items-end">
				<div class="space-y-1" data-filter-help-field>
					@SavedFilterFieldLabel("Name", "saved-filter-create-name", "saved-filter-create-help")
					<input id="saved-filter-create-name" class="caldo-input" type="text" name="name" value={ create.Name } autocomplete="off" aria-describedby="saved-filter-create-help" data-filter-help-input required/>
				</div>
				<div class="space-y-1" data-filter-help-field>
					@SavedFilterFieldLabel("Query", "saved-filter-create-query", "saved-filter-create-help")
					<input id="saved-filter-create-query" class="caldo-input" type="text" name="query" value={ create.Query } autocomplete="off" aria-describedby="saved-filter-create-help" data-filter-help-input required/>
				</div>
				<button type="submit" class="caldo-button caldo-button-primary">Filter anlegen</button>
			</div>
			@SavedFilterHelp("saved-filter-create-help")
		</div>
		<label class="inline-flex items-center gap-2 text-sm">
			<input class="caldo-check" type="checkbox" name="favorite" value="1" checked?={ create.IsFavorite }/>
			<span>Favorisieren</span>
		</label>
	</form>
}

templ SavedFilterRow(item SavedFilterItemView) {
	<li class="caldo-list-row" id={ "filter-" + item.ID }>
		<div class="space-y-3">
			<div>
				<a class="caldo-list-link" href={ templ.URL(savedFilterPath(item)) }>{ item.Name }</a>
				<p class="caldo-meta mt-1">
					{ savedFilterFavoriteLabel(item) } · { item.Query }
				</p>
			</div>
			@SavedFilterEditForm(item)
			@SavedFilterDeleteForm(item)
		</div>
	</li>
}

templ SavedFilterEditForm(item SavedFilterItemView) {
	<form
		class="space-y-2"
		method="post"
		action={ savedFilterPath(item) }
		hx-patch={ savedFilterPath(item) }
		hx-target="body"
		hx-swap="outerHTML"
		hx-push-url="false"
		hx-disabled-elt="find button"
		hx-headers={ "{\"X-CSRF-Token\":\"" + CSRFToken(ctx) + "\"}" }
		data-saved-filter-edit-form
	>
		<input type="hidden" name="expected_version" value={ savedFilterExpectedVersion(item) }/>
		if item.EditError != "" {
			<p class="caldo-alert caldo-alert-error" data-saved-filter-edit-error role="alert" aria-live="polite">{ item.EditError }</p>
		}
		<div class="caldo-filter-help-scope" data-filter-help-scope>
			<div class="grid gap-3 lg:grid-cols-[minmax(12rem,18rem)_1fr_auto] lg:items-end">
				<div class="space-y-1" data-filter-help-field>
					@SavedFilterFieldLabel("Name", "saved-filter-name-" + item.ID, savedFilterEditHelpID(item))
					<input id={ "saved-filter-name-" + item.ID } class="caldo-input" type="text" name="name" value={ savedFilterEditName(item) } autocomplete="off" aria-describedby={ savedFilterEditHelpID(item) } data-filter-help-input required/>
				</div>
				<div class="space-y-1" data-filter-help-field>
					@SavedFilterFieldLabel("Query", "saved-filter-query-" + item.ID, savedFilterEditHelpID(item))
					<input id={ "saved-filter-query-" + item.ID } class="caldo-input" type="text" name="query" value={ savedFilterEditQuery(item) } autocomplete="off" aria-describedby={ savedFilterEditHelpID(item) } data-filter-help-input required/>
				</div>
				<button type="submit" class="caldo-button caldo-button-secondary">Speichern</button>
			</div>
			@SavedFilterHelp(savedFilterEditHelpID(item))
		</div>
		<label class="inline-flex items-center gap-2 text-sm">
			<input class="caldo-check" type="checkbox" name="favorite" value="1" checked?={ savedFilterEditFavorite(item) }/>
			<span>Favorisieren</span>
		</label>
	</form>
}

templ SavedFilterFieldLabel(label string, inputID string, helpID string) {
	<div class="caldo-filter-help-label-row">
		<label class="caldo-label" for={ inputID }>{ label }</label>
		<button
			type="button"
			class="caldo-icon-button caldo-filter-help-toggle"
			data-filter-help-toggle
			aria-controls={ helpID }
			aria-expanded="false"
			aria-label={ Text(ctx).FilterHelpToggle + ": " + label }
		>
			<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 16v-4"></path>
				<path d="M12 8h.01"></path>
			</svg>
		</button>
	</div>
}

templ SavedFilterHelp(helpID string) {
	<aside id={ helpID } class="caldo-filter-help" data-filter-help-popover role="note">
		<p class="caldo-filter-help-title">{ Text(ctx).FilterHelpTitle }</p>
		<p>{ Text(ctx).FilterHelpName }</p>
		<p>{ Text(ctx).FilterHelpQuery }</p>
		<dl class="caldo-filter-help-syntax">
			<div><dt>{ Text(ctx).FilterHelpDates }</dt><dd><code>today</code>, <code>overdue</code>, <code>upcoming</code>, <code>no date</code></dd></div>
			<div><dt>{ Text(ctx).FilterHelpScope }</dt><dd><code>#Projekt</code>, <code>{ "@Label" }</code></dd></div>
			<div><dt>{ Text(ctx).FilterHelpFields }</dt><dd><code>priority:high</code>, <code>completed:false</code>, <code>text:foo</code>, <code>before:YYYY-MM-DD</code>, <code>after:YYYY-MM-DD</code></dd></div>
			<div><dt>{ Text(ctx).FilterHelpBoolean }</dt><dd><code>AND</code>, <code>OR</code>, <code>NOT</code></dd></div>
		</dl>
		<p class="caldo-filter-help-example">{ Text(ctx).FilterHelpExample }</p>
	</aside>
}

templ SavedFilterDeleteForm(item SavedFilterItemView) {
	<details class="space-y-2" open?={ item.DeleteError != "" } data-saved-filter-delete-panel>
		<summary class="caldo-button caldo-button-danger">Filter löschen</summary>
		<form
			class="space-y-2"
			method="post"
			action={ savedFilterPath(item) }
			hx-delete={ savedFilterPath(item) }
			hx-target="body"
			hx-swap="outerHTML"
			hx-push-url="false"
			hx-disabled-elt="find button"
			hx-headers={ "{\"X-CSRF-Token\":\"" + CSRFToken(ctx) + "\"}" }
			data-saved-filter-delete-form
		>
			<input type="hidden" name="expected_version" value={ savedFilterExpectedVersion(item) }/>
			if item.DeleteError != "" {
				<p class="caldo-alert caldo-alert-error" data-saved-filter-delete-error role="alert" aria-live="polite">{ item.DeleteError }</p>
			}
			<button type="submit" class="caldo-button caldo-button-danger-solid">Endgültig löschen</button>
		</form>
	</details>
}
