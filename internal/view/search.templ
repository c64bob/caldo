package view

import "strings"

templ SearchPage(query string, results []SearchResultView) {
	<section class="caldo-page">
		<h2 class="caldo-page-title">Globale Suche</h2>
		<form method="get" action="/search" class="space-y-2" role="search" aria-label="Globale Suche">
			<label for="global-search" class="caldo-label">Suche nach Aufgaben, #Projekt oder @Label</label>
			<input
				id="global-search"
				type="search"
				name="q"
				value={ query }
				class="caldo-input"
				placeholder="z. B. Rechnung #Finanzen @Büro"
				autofocus
				accesskey="k"
			/>
			<p class="caldo-muted">Tastaturkürzel: Alt+Shift+K (Browser-Standard für accesskey).</p>
		</form>
		if strings.TrimSpace(query) == "" {
			<p class="caldo-muted">Gib einen Suchbegriff ein.</p>
		} else if len(results) == 0 {
			<p class="caldo-muted">Keine aktiven Aufgaben gefunden.</p>
		} else {
			<ul class="caldo-list" data-search-results>
				for _, result := range results {
					<li data-task-id={ result.ID } class="caldo-task-row">
						<p class="font-medium">{ result.Title }</p>
						if result.Description != "" {
							<p class="caldo-muted">{ result.Description }</p>
						}
						<p class="caldo-meta mt-1">
							Projekt: { result.ProjectName }
							if result.LabelNames != "" {
								 · Labels: { result.LabelNames }
							}
						</p>
						if len(result.Attachments) > 0 {
							<div class="caldo-meta mt-2">
								<p>Anhänge:</p>
								<ul class="ml-4 list-disc space-y-1">
									for _, attachment := range result.Attachments {
										<li>
											if attachment.IsExternalURL {
												<a href={ templ.SafeURL(attachment.Value) } target="_blank" rel="noopener noreferrer" class="caldo-list-link">{ attachment.Value }</a>
											} else {
												Anhang vorhanden (inline/binary)
											}
										</li>
									}
								</ul>
							</div>
						}
					</li>
				}
			</ul>
		}
	</section>
}
