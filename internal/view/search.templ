package view

import "strings"

templ SearchPage(query string, results []TaskRowView) {
	<section class="caldo-page">
		<h2 class="caldo-page-title">Globale Suche</h2>
		<form method="get" action="/search" class="space-y-2" role="search" aria-label="Globale Suche">
			<label for="global-search" class="caldo-label">Suche nach Aufgaben, #Projekt oder @Label</label>
			<input
				id="global-search"
				type="search"
				name="q"
				value={ query }
				class="caldo-input"
				placeholder="z. B. Rechnung #Finanzen @Büro"
				autofocus
				accesskey="k"
			/>
			<p class="caldo-muted">Tastaturkürzel: Alt+Shift+K (Browser-Standard für accesskey).</p>
		</form>
		if strings.TrimSpace(query) == "" {
			@EmptyState("Noch keine Suche", "Gib einen Suchbegriff ein.")
		} else if len(results) == 0 {
			@EmptyState("Keine aktiven Aufgaben gefunden", "Passe den Suchbegriff oder Projekt- und Labeltokens an.")
		} else {
			<ul class="caldo-list caldo-task-list" data-search-results>
				for _, result := range results {
					@TaskRow(result)
				}
			</ul>
		}
	</section>
}
