package view

templ SyncStatusFrame(state string, lastSuccess LocalDateTimeView) {
	<div class="caldo-sync-status" id="sync-status">
		@SyncStatusBadge(state, lastSuccess)
	</div>
}

templ SyncStatusBadge(state string, lastSuccess LocalDateTimeView) {
	<button
		type="button"
		class={ syncActionClass(state) }
		data-sync-request
		data-sync-state={ syncState(state) }
		data-sync-tooltip-template={ syncTooltipTemplate(ctx, state) }
		hx-post="/sync/manual"
		hx-target="#sync-status"
		hx-swap="innerHTML"
		hx-headers={ "{\"X-CSRF-Token\":\"" + CSRFToken(ctx) + "\"}" }
		aria-label={ syncTooltipLabel(ctx, state, lastSuccess) }
		title={ syncTooltipLabel(ctx, state, lastSuccess) }
	>
		<span class="caldo-sync-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
				<path d="M21 2v6h-6"></path>
				<path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
				<path d="M3 22v-6h6"></path>
				<path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
			</svg>
		</span>
		<span class="caldo-sync-state-dot" aria-hidden="true"></span>
		<span class="sr-only">
			{ Text(ctx).SettingsSyncStatus }:{ " " }{ syncStateLabel(ctx, state) }.
			{ Text(ctx).SettingsSyncLastOK }:{ " " }
			<span data-sync-last-value>
				@LocalDateTime(lastSuccess)
			</span>
		</span>
	</button>
	if state == "running" {
		<span hidden aria-hidden="true" hx-get="/sync/status" hx-trigger="load delay:1s" hx-target="#sync-status" hx-swap="innerHTML"></span>
	}
}
