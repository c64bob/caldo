package view

import (
	"fmt"
	"strings"
)

templ TaskRow(task TaskRowView) {
	<li
		data-task-id={ task.ID }
		data-parent-task-id={ task.ParentID }
		data-sync-status={ task.SyncStatus }
		data-task-status={ task.Status }
		data-server-version={ fmt.Sprint(task.ServerVersion) }
		data-task-project-id={ task.ProjectID }
		data-task-move-path={ taskMovePath(task) }
		data-task-drag-move?={ taskCanDragMove(task) }
		draggable={ taskDragMoveDraggable(task) }
		class={
			"caldo-task-row",
			templ.KV("caldo-task-row-subtask", task.IsSubtask),
			templ.KV("caldo-task-row-completed", taskIsCompleted(task)),
			templ.KV("caldo-task-row-conflict", strings.EqualFold(task.SyncStatus, "conflict")),
			templ.KV("caldo-task-row-error", strings.EqualFold(task.SyncStatus, "error")),
		}
		tabindex="0"
	>
		<div class="caldo-task-row-grid">
			<form
				method="post"
				action={ taskCompletionPath(task) }
				hx-post={ taskCompletionPath(task) }
				hx-swap="none"
				hx-disabled-elt="find button"
				hx-headers={ taskCSRFHeaders(ctx) }
				data-refresh-after-write="true"
				data-task-action-form
				class="caldo-task-check-form"
			>
				<input type="hidden" name="expected_version" value={ fmt.Sprint(task.ServerVersion) }/>
				if taskNeedsCompletionDecision(task) {
					<label
						class="caldo-task-checkbox-label"
						aria-label={ taskCompletionLabel(task) }
						aria-haspopup="dialog"
						aria-controls={ taskDOMID("task-complete", task) }
						aria-expanded="false"
						data-task-complete-open
					>
						<input
							type="checkbox"
							class="caldo-task-checkbox-input"
							aria-label={ taskCompletionLabel(task) }
							checked?={ taskIsCompleted(task) }
						/>
						<span class="caldo-task-checkbox" aria-hidden="true">
							<span aria-hidden="true" class="caldo-task-checkbox-mark"></span>
						</span>
					</label>
				} else {
					<label
						class="caldo-task-checkbox-label"
						aria-label={ taskCompletionLabel(task) }
					>
						<input
							type="checkbox"
							class="caldo-task-checkbox-input"
							aria-label={ taskCompletionLabel(task) }
							checked?={ taskIsCompleted(task) }
							disabled?={ !taskCanToggleCompletion(task) }
							data-task-completion-checkbox
						/>
						<span class="caldo-task-checkbox" aria-hidden="true">
							<span aria-hidden="true" class="caldo-task-checkbox-mark"></span>
						</span>
					</label>
				}
			</form>
			<div class="caldo-task-content" data-inline-task-display>
				<div class="caldo-task-title-line">
					<p class="caldo-task-title">{ taskRowTitle(task) }</p>
					if taskCanShowFavorite(task) {
						<form
							method="post"
							action={ taskFavoritePath(task) }
							hx-post={ taskFavoritePath(task) }
							hx-swap="none"
							hx-disabled-elt="find button"
							hx-headers={ taskCSRFHeaders(ctx) }
							data-refresh-after-write="true"
							data-task-action-form
							data-task-favorite-form
							class="caldo-task-favorite-form"
						>
							<input type="hidden" name="expected_version" value={ fmt.Sprint(task.ServerVersion) }/>
							<input type="hidden" name="favorite" value={ taskFavoriteNextValue(task) }/>
							<button
								type="submit"
								class={
									"caldo-task-favorite-button",
									templ.KV("caldo-task-favorite-button-active", taskIsFavorite(task)),
								}
								aria-label={ taskFavoriteLabel(task) }
								aria-pressed={ taskFavoritePressed(task) }
								title={ taskFavoriteLabel(task) }
								disabled?={ !taskCanToggleCompletion(task) }
							>
								if taskIsFavorite(task) {
									<span aria-hidden="true">★</span>
								} else {
									<span aria-hidden="true">☆</span>
								}
							</button>
						</form>
					}
					for _, state := range taskStateChips(task) {
						<span class={ state.Class }>{ state.Label }</span>
					}
					if taskCanInlineEdit(task) {
						<button
							type="button"
							class="caldo-task-edit-open"
							data-inline-task-edit-open
							aria-expanded="false"
						>
							Bearbeiten
						</button>
					}
					if taskUsesConflictLink(task) {
						<a
							class="caldo-task-detail-open"
							href={ templ.URL(taskConflictPath(task)) }
							data-task-conflict-link
						>
							Konfliktlösung
						</a>
					} else if taskCanOpenDetail(task) {
						<button
							type="button"
							class="caldo-task-detail-open"
							data-task-detail-open
							aria-haspopup="dialog"
							aria-controls={ taskDOMID("task-detail", task) }
						>
							Details
						</button>
					}
				</div>
				if taskRowDescription(task) != "" {
					<p class="caldo-task-description">@TaskDescriptionText(taskRowDescription(task))</p>
				}
				<div class="caldo-task-meta-line">
					for _, chip := range taskRelationshipChips(task) {
						<span class={ chip.Class }>{ chip.Label }</span>
					}
					for _, chip := range taskMetaChips(task) {
						<span class={ chip.Class }>{ chip.Label }</span>
					}
					for _, chip := range taskLabelChips(task) {
						<span class={ chip.Class }>{ chip.Label }</span>
					}
				</div>
				if len(task.Attachments) > 0 {
					<div class="caldo-task-attachments" aria-label="Anhänge">
						for _, attachment := range task.Attachments {
							if attachment.IsExternalURL {
								<a href={ templ.SafeURL(attachment.Value) } target="_blank" rel="noopener noreferrer" class="caldo-task-attachment-link">{ attachment.Value }</a>
							} else {
								<span class="caldo-task-chip">Anhang vorhanden (inline/binary)</span>
							}
						}
					</div>
				}
				<p id={ taskDOMID("task-action-error", task) } class="caldo-alert caldo-alert-error caldo-task-action-error" data-task-action-error role="alert" aria-live="polite" hidden>Aktion konnte nicht ausgeführt werden.</p>
			</div>
			if taskCanInlineEdit(task) {
				<form
					method="post"
					action={ taskEditPath(task) }
					hx-patch={ taskEditPath(task) }
					hx-swap="none"
					hx-disabled-elt="find button"
					hx-headers={ taskCSRFHeaders(ctx) }
					data-refresh-after-write="true"
					data-inline-task-edit-form
					class="caldo-task-edit-form"
					aria-label={ "Aufgabe bearbeiten: " + taskRowTitle(task) }
					aria-describedby={ taskDOMID("task-edit-error", task) }
					hidden
				>
					<input type="hidden" name="expected_version" value={ fmt.Sprint(task.ServerVersion) }/>
					<input type="hidden" name="status" value={ task.Status }/>
					<label class="caldo-task-edit-field">
						<span>Titel</span>
						<input
							type="text"
							name="title"
							required
							autocomplete="off"
							class="caldo-input caldo-task-edit-title"
							value={ taskRowTitle(task) }
							data-inline-task-edit-title
							aria-describedby={ taskDOMID("task-edit-error", task) }
						/>
					</label>
					<label class="caldo-task-edit-field">
						<span>Beschreibung</span>
						<textarea name="description" rows="3" class="caldo-input caldo-task-edit-description">{ taskRowDescription(task) }</textarea>
					</label>
					<div class="caldo-task-edit-grid">
						<label class="caldo-task-edit-field">
							<span>Projekt</span>
							if len(taskProjectOptions(task)) > 0 {
								<select name="project_id" class="caldo-select">
									for _, project := range taskProjectOptions(task) {
										<option value={ project.ID } selected?={ strings.TrimSpace(project.ID) == strings.TrimSpace(task.ProjectID) }>{ project.Name }</option>
									}
								</select>
							} else {
								<input type="hidden" name="project_id" value={ task.ProjectID }/>
								<span class="caldo-task-edit-static">{ task.ProjectName }</span>
							}
						</label>
						<label class="caldo-task-edit-field">
							<span>Fällig</span>
							<input type="date" name="due_date" value={ task.DueISODate } class="caldo-input"/>
						</label>
						<label class="caldo-task-edit-field">
							<span>Priorität</span>
							<select name="priority" class="caldo-select">
								for _, priority := range taskPriorityOptions() {
									<option value={ priority.Value } selected?={ priority.Value == taskPriorityValue(task) }>{ priority.Label }</option>
								}
							</select>
						</label>
						<label class="caldo-task-edit-field caldo-task-edit-field-wide">
							<span>Labels</span>
							<input type="text" name="labels" value={ taskEditableLabels(task) } class="caldo-input" autocomplete="off" data-task-labels-input/>
						</label>
					</div>
					<p id={ taskDOMID("task-edit-error", task) } class="caldo-alert caldo-alert-error caldo-task-edit-error" data-inline-task-edit-error role="alert" aria-live="polite" hidden>Aufgabe konnte nicht gespeichert werden.</p>
					<div class="caldo-task-edit-actions">
						<button type="submit" class="caldo-button caldo-button-primary">Speichern</button>
						<button type="button" class="caldo-button caldo-button-ghost" data-inline-task-edit-cancel>Abbrechen</button>
						<span class="htmx-indicator caldo-meta" aria-live="polite">Speichern ...</span>
					</div>
				</form>
			}
			if taskCanInlineEdit(task) && (taskCanCreateSubtask(task) || taskCanDelete(task)) {
				<div class="caldo-task-edit-extra" data-inline-task-edit-extra hidden>
					if taskCanCreateSubtask(task) {
						@SubtaskCreate(task)
					}
					if taskCanDelete(task) {
						<div class="caldo-task-actions" data-task-actions>
							<button
								type="button"
								class="caldo-button caldo-button-ghost caldo-button-danger"
								data-task-delete-open
								aria-haspopup="dialog"
								aria-controls={ taskDOMID("task-delete", task) }
							>
								Löschen
							</button>
						</div>
					}
				</div>
			}
		</div>
		if taskNeedsCompletionDecision(task) {
			@TaskCompleteDialog(task)
		}
		if taskCanOpenDetail(task) && !taskUsesConflictLink(task) {
			@TaskDetailPanel(task)
		}
		if taskCanDelete(task) {
			@TaskDeleteDialog(task)
		}
	</li>
}

templ TaskDescriptionText(description string) {
	for _, segment := range taskDescriptionSegments(description) {
		if segment.URL != "" {
			<a href={ templ.SafeURL(segment.URL) } target="_blank" rel="noopener noreferrer" class="caldo-task-description-link">{ segment.Text }</a>
		} else {
			{ segment.Text }
		}
	}
}

templ SubtaskCreate(task TaskRowView) {
	<div class="caldo-subtask-create" data-inline-task-create data-subtask-create>
		<button
			type="button"
			class="caldo-subtask-create-trigger"
			data-inline-task-create-trigger
			aria-expanded="false"
		>
			<span class="caldo-subtask-create-plus" aria-hidden="true">+</span>
			<span>Unteraufgabe hinzufügen</span>
		</button>
		<form
			method="post"
			action={ taskSubtaskCreatePath(task) }
			hx-post={ taskSubtaskCreatePath(task) }
			hx-swap="none"
			hx-disabled-elt="find button"
			hx-headers={ taskCSRFHeaders(ctx) }
			data-refresh-after-write="true"
			data-inline-task-create-form
			data-subtask-create-form
			class="caldo-subtask-create-form"
			aria-describedby={ taskDOMID("subtask-create-error", task) }
			hidden
		>
			<input
				type="text"
				name="title"
				required
				autocomplete="off"
				class="caldo-input caldo-subtask-create-input"
				placeholder="Unteraufgabe hinzufügen"
				aria-label="Unteraufgabentitel"
				aria-describedby={ taskDOMID("subtask-create-error", task) }
				data-inline-task-create-title
			/>
			<p id={ taskDOMID("subtask-create-error", task) } class="caldo-alert caldo-alert-error caldo-inline-create-error" data-inline-task-create-error role="alert" aria-live="polite" hidden>Unteraufgabe konnte nicht gespeichert werden.</p>
			<div class="caldo-subtask-create-actions">
				<button type="submit" class="caldo-button caldo-button-primary">Speichern</button>
				<button type="button" class="caldo-button caldo-button-ghost" data-inline-task-create-cancel>Abbrechen</button>
				<span class="htmx-indicator caldo-meta" aria-live="polite">Speichern ...</span>
			</div>
		</form>
	</div>
}

templ TaskDetailPanel(task TaskRowView) {
	<dialog
		id={ taskDOMID("task-detail", task) }
		class="caldo-task-detail-dialog"
		data-task-detail-dialog
		aria-labelledby={ taskDOMID("task-detail-title", task) }
		aria-describedby={ taskDOMID("task-detail-error", task) }
	>
		<div class="caldo-task-detail-shell">
			<header class="caldo-task-detail-header">
				<div class="caldo-task-detail-heading">
					<p class="caldo-meta">Aufgabe</p>
					<h2 id={ taskDOMID("task-detail-title", task) } class="caldo-task-detail-title">{ taskRowTitle(task) }</h2>
				</div>
				<button type="button" class="caldo-icon-button caldo-task-detail-close" data-task-detail-close aria-label="Details schließen">×</button>
			</header>
			<div class="caldo-task-detail-state">
				for _, state := range taskStateChips(task) {
					<span class={ state.Class }>{ state.Label }</span>
				}
				for _, chip := range taskRelationshipChips(task) {
					<span class={ chip.Class }>{ chip.Label }</span>
				}
				if taskRecurrence(task).Label != "" {
					<span class="caldo-task-chip">{ taskRecurrence(task).Label }</span>
				}
			</div>
			if taskDetailStatusMessage(task) != "" {
				<p class="caldo-alert caldo-alert-warning caldo-task-detail-status">{ taskDetailStatusMessage(task) }</p>
			}
			<p id={ taskDOMID("task-detail-error", task) } class="caldo-alert caldo-alert-error caldo-task-detail-error" data-task-detail-error role="alert" aria-live="polite" hidden>Aufgabe konnte nicht gespeichert werden.</p>
			<form
				method="post"
				action={ taskEditPath(task) }
				hx-patch={ taskEditPath(task) }
				hx-swap="none"
				hx-disabled-elt="find button"
				hx-headers={ taskCSRFHeaders(ctx) }
				data-refresh-after-write="true"
				data-task-detail-form
				class="caldo-task-detail-form"
				aria-label={ "Aufgabendetails bearbeiten: " + taskRowTitle(task) }
				aria-describedby={ taskDOMID("task-detail-error", task) }
			>
				<input type="hidden" name="expected_version" value={ fmt.Sprint(task.ServerVersion) }/>
				<input type="hidden" name="status" value={ task.Status }/>
				<label class="caldo-task-detail-field caldo-task-detail-field-wide">
					<span>Titel</span>
					<input
						type="text"
						name="title"
						required
						autocomplete="off"
						class="caldo-input caldo-task-detail-title-input"
						value={ taskRowTitle(task) }
						data-task-detail-title
						aria-describedby={ taskDOMID("task-detail-error", task) }
						disabled?={ !taskCanDetailEdit(task) }
					/>
				</label>
				<label class="caldo-task-detail-field caldo-task-detail-field-wide">
					<span>Beschreibung</span>
					<textarea name="description" rows="7" class="caldo-input caldo-task-detail-description" disabled?={ !taskCanDetailEdit(task) }>{ taskRowDescription(task) }</textarea>
				</label>
				<div class="caldo-task-detail-grid">
					<label class="caldo-task-detail-field">
						<span>Projekt</span>
						if len(taskProjectOptions(task)) > 0 {
							<select name="project_id" class="caldo-select" disabled?={ !taskCanDetailEdit(task) }>
								for _, project := range taskProjectOptions(task) {
									<option value={ project.ID } selected?={ strings.TrimSpace(project.ID) == strings.TrimSpace(task.ProjectID) }>{ project.Name }</option>
								}
							</select>
						} else {
							<input type="hidden" name="project_id" value={ task.ProjectID } disabled?={ !taskCanDetailEdit(task) }/>
							<span class="caldo-task-detail-static">{ task.ProjectName }</span>
						}
					</label>
					<label class="caldo-task-detail-field">
						<span>Fälligkeit</span>
						<input type="date" name="due_date" value={ task.DueISODate } class="caldo-input" disabled?={ !taskCanDetailEdit(task) }/>
					</label>
					<label class="caldo-task-detail-field">
						<span>Priorität</span>
						<select name="priority" class="caldo-select" disabled?={ !taskCanDetailEdit(task) }>
							for _, priority := range taskPriorityOptions() {
								<option value={ priority.Value } selected?={ priority.Value == taskPriorityValue(task) }>{ priority.Label }</option>
							}
						</select>
					</label>
					<label class="caldo-task-detail-field caldo-task-detail-field-wide">
						<span>Labels</span>
						<input type="text" name="labels" value={ taskEditableLabels(task) } class="caldo-input" autocomplete="off" disabled?={ !taskCanDetailEdit(task) } data-task-labels-input/>
					</label>
				</div>
				<section class="caldo-task-detail-section" aria-label="Wiederholung">
					<div class="caldo-task-detail-section-heading">
						<h3>Wiederholung</h3>
					</div>
					if taskRecurrence(task).Editable {
						<input type="hidden" name="repeat_update" value="1" disabled data-task-recurrence-update/>
						<div class="caldo-task-detail-grid">
							<label class="caldo-task-detail-field">
								<span>Rhythmus</span>
								<select name="repeat_freq" class="caldo-select" disabled?={ !taskCanDetailEdit(task) } data-task-recurrence-control>
									for _, option := range taskRecurrenceFrequencyOptions() {
										<option value={ option.Value } selected?={ option.Value == taskRecurrence(task).Frequency }>{ option.Label }</option>
									}
								</select>
							</label>
							<label class="caldo-task-detail-field">
								<span>Intervall</span>
								<input type="number" min="1" step="1" name="repeat_interval" value={ taskRecurrence(task).Interval } class="caldo-input" disabled?={ !taskCanDetailEdit(task) } data-task-recurrence-control/>
							</label>
							<label class="caldo-task-detail-field">
								<span>Wochentag</span>
								<select name="repeat_byday" class="caldo-select" disabled?={ !taskCanDetailEdit(task) } data-task-recurrence-control>
									for _, option := range taskByDayOptions() {
										<option value={ option.Value } selected?={ option.Value == taskRecurrence(task).ByDay }>{ option.Label }</option>
									}
								</select>
							</label>
							<label class="caldo-task-detail-field">
								<span>Ende</span>
								<select name="repeat_end" class="caldo-select" disabled?={ !taskCanDetailEdit(task) } data-task-recurrence-control>
									for _, option := range taskRecurrenceEndOptions() {
										<option value={ option.Value } selected?={ option.Value == taskRecurrence(task).End }>{ option.Label }</option>
									}
								</select>
							</label>
							<label class="caldo-task-detail-field">
								<span>Bis</span>
								<input type="date" name="repeat_until" value={ taskRecurrence(task).Until } class="caldo-input" disabled?={ !taskCanDetailEdit(task) } data-task-recurrence-control/>
							</label>
							<label class="caldo-task-detail-field">
								<span>Anzahl</span>
								<input type="number" min="1" step="1" name="repeat_count" value={ taskRecurrence(task).Count } class="caldo-input" disabled?={ !taskCanDetailEdit(task) } data-task-recurrence-control/>
							</label>
						</div>
					} else {
						<p class="caldo-task-detail-static">{ taskRecurrence(task).Label }</p>
						<p class="caldo-meta">Komplexe Wiederholung wird unverändert erhalten.</p>
					}
				</section>
				<section class="caldo-task-detail-section" aria-label="Anhänge">
					<div class="caldo-task-detail-section-heading">
						<h3>Anhänge</h3>
					</div>
					if len(task.Attachments) > 0 {
						<ul class="caldo-task-detail-attachments">
							for _, attachment := range task.Attachments {
								<li>
									if attachment.IsExternalURL {
										<a href={ templ.SafeURL(attachment.Value) } target="_blank" rel="noopener noreferrer" class="caldo-task-detail-attachment-link">{ attachment.Value }</a>
									} else {
										<span class="caldo-task-detail-static">Anhang vorhanden (inline/binary)</span>
									}
								</li>
							}
						</ul>
					} else {
						<p class="caldo-muted">Keine Anhänge</p>
					}
				</section>
				<div class="caldo-task-detail-actions">
					<button type="submit" class="caldo-button caldo-button-primary" disabled?={ !taskCanDetailEdit(task) }>Speichern</button>
					<button type="button" class="caldo-button caldo-button-ghost" data-task-detail-close>Schließen</button>
					<span class="htmx-indicator caldo-meta" aria-live="polite">Speichern ...</span>
				</div>
			</form>
		</div>
	</dialog>
}

templ TaskCompleteDialog(task TaskRowView) {
	<dialog
		id={ taskDOMID("task-complete", task) }
		class="caldo-task-complete-dialog"
		data-task-complete-dialog
		aria-labelledby={ taskDOMID("task-complete-title", task) }
		aria-describedby={ taskDOMID("task-complete-error", task) }
	>
		<div class="caldo-task-complete-shell">
			<header class="caldo-task-complete-header">
				<div class="caldo-task-complete-heading">
					<p class="caldo-meta">Unteraufgaben</p>
					<h2 id={ taskDOMID("task-complete-title", task) } class="caldo-task-complete-title">Aufgabe erledigen</h2>
				</div>
				<button type="button" class="caldo-icon-button caldo-task-complete-close" data-task-complete-close aria-label="Erledigen abbrechen">×</button>
			</header>
			<div class="caldo-task-complete-body">
				<p class="caldo-task-complete-copy">"{ taskRowTitle(task) }" hat { taskOpenSubtaskCountLabel(task.OpenSubtaskCount) }.</p>
				<p class="caldo-task-complete-copy">Wähle, ob nur die Elternaufgabe oder auch die offenen direkten Unteraufgaben erledigt werden.</p>
				<p id={ taskDOMID("task-complete-error", task) } class="caldo-alert caldo-alert-error caldo-task-complete-error" data-task-complete-error role="alert" aria-live="polite" hidden>Aufgabe konnte nicht erledigt werden.</p>
				<div class="caldo-task-complete-actions">
					<form
						method="post"
						action={ taskCompletionPath(task) }
						hx-post={ taskCompletionPath(task) }
						hx-swap="none"
						hx-disabled-elt="find button"
						hx-headers={ taskCSRFHeaders(ctx) }
						data-refresh-after-write="true"
						data-task-complete-form
						class="caldo-task-complete-form"
						aria-describedby={ taskDOMID("task-complete-error", task) }
					>
						<input type="hidden" name="expected_version" value={ fmt.Sprint(task.ServerVersion) }/>
						<input type="hidden" name="subtasks_action" value="parent_only"/>
						<button type="submit" class="caldo-button caldo-button-secondary">Nur Elternaufgabe erledigen</button>
						<span class="htmx-indicator caldo-meta" aria-live="polite">Speichern ...</span>
					</form>
					<form
						method="post"
						action={ taskCompletionPath(task) }
						hx-post={ taskCompletionPath(task) }
						hx-swap="none"
						hx-disabled-elt="find button"
						hx-headers={ taskCSRFHeaders(ctx) }
						data-refresh-after-write="true"
						data-task-complete-form
						class="caldo-task-complete-form"
						aria-describedby={ taskDOMID("task-complete-error", task) }
					>
						<input type="hidden" name="expected_version" value={ fmt.Sprint(task.ServerVersion) }/>
						<input type="hidden" name="subtasks_action" value="complete_open"/>
						<button type="submit" class="caldo-button caldo-button-primary">{ taskCompleteWithSubtasksLabel(task) }</button>
						<span class="htmx-indicator caldo-meta" aria-live="polite">Speichern ...</span>
					</form>
					<button type="button" class="caldo-button caldo-button-ghost" data-task-complete-close data-task-complete-cancel>Abbrechen</button>
				</div>
			</div>
		</div>
	</dialog>
}

templ TaskDeleteDialog(task TaskRowView) {
	<dialog
		id={ taskDOMID("task-delete", task) }
		class="caldo-task-delete-dialog"
		data-task-delete-dialog
		aria-labelledby={ taskDOMID("task-delete-title", task) }
		aria-describedby={ taskDOMID("task-delete-error", task) }
	>
		<div class="caldo-task-delete-shell">
			<header class="caldo-task-delete-header">
				<div class="caldo-task-delete-heading">
					<p class="caldo-meta">Aufgabe</p>
					<h2 id={ taskDOMID("task-delete-title", task) } class="caldo-task-delete-title">Aufgabe löschen</h2>
				</div>
				<button type="button" class="caldo-icon-button caldo-task-delete-close" data-task-delete-close aria-label="Löschen abbrechen">×</button>
			</header>
			<div class="caldo-task-delete-body">
				<p class="caldo-task-delete-copy">"{ taskRowTitle(task) }" wirklich löschen?</p>
				if taskHasDirectSubtasks(task) {
					<p class="caldo-task-delete-copy">{ taskDeleteSubtaskWarning(task) }</p>
				}
				<p id={ taskDOMID("task-delete-error", task) } class="caldo-alert caldo-alert-error caldo-task-delete-error" data-task-delete-error role="alert" aria-live="polite" hidden>Aufgabe konnte nicht gelöscht werden.</p>
				<form
					method="post"
					action={ taskDeletePath(task) }
					hx-delete={ taskDeletePath(task) }
					hx-swap="none"
					hx-disabled-elt="find button"
					hx-headers={ taskCSRFHeaders(ctx) }
					data-task-delete-form
					class="caldo-task-delete-form"
					aria-describedby={ taskDOMID("task-delete-error", task) }
				>
					<input type="hidden" name="expected_version" value={ fmt.Sprint(task.ServerVersion) }/>
					if taskHasDirectSubtasks(task) {
						<input type="hidden" name="subtasks_action" value="delete_all"/>
					}
					<div class="caldo-task-delete-actions">
						<button type="submit" class="caldo-button caldo-button-primary caldo-button-danger-solid">{ taskDeleteSubmitLabel(task) }</button>
						<button type="button" class="caldo-button caldo-button-ghost" data-task-delete-close data-task-delete-cancel>Abbrechen</button>
						<span class="htmx-indicator caldo-meta" aria-live="polite">Löscht ...</span>
					</div>
				</form>
			</div>
		</div>
	</dialog>
}

templ InlineTaskCreate(create InlineTaskCreateView) {
	if create.Enabled {
		<div class="caldo-inline-create" data-inline-task-create>
			<button
				type="button"
				class="caldo-inline-create-trigger"
				data-inline-task-create-trigger
				aria-expanded="false"
			>
				<span class="caldo-inline-create-plus" aria-hidden="true">+</span>
				<span>{ inlineTaskCreatePlaceholder(create) }</span>
			</button>
			<form
				method="post"
				action="/tasks/"
				hx-post="/tasks/"
				hx-swap="none"
				hx-disabled-elt="find button"
				hx-headers={ taskCSRFHeaders(ctx) }
				data-refresh-after-write="true"
				data-inline-task-create-form
				class="caldo-inline-create-form"
				hidden
			>
				if create.ProjectID != "" {
					<input type="hidden" name="project_id" value={ create.ProjectID }/>
				}
				if create.DueDate != "" {
					<input type="hidden" name="due_date" value={ create.DueDate }/>
				}
				<input
					type="text"
					name="title"
					required
					autocomplete="off"
					class="caldo-input caldo-inline-create-input"
					placeholder={ inlineTaskCreatePlaceholder(create) }
					aria-label="Aufgabentitel"
					data-inline-task-create-title
				/>
				if len(inlineTaskCreateContextChips(create)) > 0 {
					<div class="caldo-inline-create-meta" aria-label="Kontext">
						for _, chip := range inlineTaskCreateContextChips(create) {
							<span class={ chip.Class }>{ chip.Label }</span>
						}
					</div>
				}
				<p class="caldo-alert caldo-alert-error caldo-inline-create-error" data-inline-task-create-error role="alert" aria-live="polite" hidden>Aufgabe konnte nicht gespeichert werden.</p>
				<div class="caldo-inline-create-actions">
					<button type="submit" class="caldo-button caldo-button-primary">Speichern</button>
					<button type="button" class="caldo-button caldo-button-ghost" data-inline-task-create-cancel>Abbrechen</button>
					<span class="htmx-indicator caldo-meta" aria-live="polite">Speichern ...</span>
				</div>
			</form>
		</div>
	}
}
