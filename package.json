{
  "name": "caldo",
  "private": true,
  "description": "Dev-only browser QA tooling for Caldo.",
  "scripts": {
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:performance": "CALDO_E2E_PERF=1 playwright test tests/e2e/performance.spec.js --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:ci": "npm run test:e2e && npm run test:e2e:webkit",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:webkit:headed": "playwright test --project=webkit --headed",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  },
  "engines": {
    "node": ">=20"
  }
}
